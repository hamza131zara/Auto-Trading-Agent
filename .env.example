APP_ENV=development
LOG_LEVEL=info
TELEMETRY_OPT_IN=false
LIVE_TRADING_ENABLED=false

# The signed provider trust registry is opt-in. Keep disabled until an owner has
# provisioned and independently reviewed the exact endpoint, DNS/IP allowlist,
# registry identity, Ed25519 public root and its SPKI SHA-256 fingerprint.
ATA_PROVIDER_TRUST_REGISTRY_ENABLED=false
